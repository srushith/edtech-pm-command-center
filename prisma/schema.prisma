// EdTech PM Command Center — data model (PostgreSQL).
//
// Multi-tenant: every domain row belongs to a Workspace. Required parent links
// include workspaceId in the foreign key ([parentId, workspaceId] -> [id, workspaceId]),
// so the database rejects a child that points into another workspace. Optional
// links can't (Prisma requires all-or-nothing optionality); lib/data enforces those
// and /data checks them. isDemo marks rows created by "Start with demo data".

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum Region {
  US
  INDIA
  GLOBAL
}

enum CourseStatus {
  ACTIVE
  IN_DEVELOPMENT
  SUNSET
}

enum CohortStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

enum HealthStatus {
  HEALTHY
  ATTENTION
  CRITICAL
}

enum HiringStage {
  SOURCED
  SCREENING
  INTERVIEW
  TRIAL_SESSION
  OFFER
  ACTIVE
  INACTIVE
}

enum ModuleStage {
  PLANNED
  DRAFTING
  SME_REVIEW
  QA
  PUBLISHED
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum IssueCategory {
  CONTENT
  INSTRUCTOR
  TECHNICAL
  SCHEDULING
  PLATFORM
  LEARNER_SUPPORT
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  RESOLVED
}

enum ProjectType {
  PROJECT
  CAPSTONE
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  GRADING
  COMPLETED
}

enum LaunchStatus {
  PLANNING
  ON_TRACK
  AT_RISK
  LAUNCHED
}

// ---------- Accounts & workspaces ----------

enum Role {
  OWNER
  EDITOR
  VIEWER
}

// Auth.js (JWT sessions, so no auth Session table; that name is the class session below).
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts      Account[]
  memberships   Membership[]
  invitesSent   Invite[]
  importSources ImportSource[]
}

model Account {
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@id([provider, providerAccountId])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  memberships    Membership[]
  invites        Invite[]
  courses        Course[]
  cohorts        Cohort[]
  instructors    Instructor[]
  smes           SME[]
  modules        Module[]
  moduleVersions ModuleVersion[]
  sessions       Session[]
  feedback       LearnerFeedback[]
  issues         Issue[]
  projects       Project[]
  launches       Launch[]
  checklistItems ChecklistItem[]
  activity       ActivityEvent[]
  importSources  ImportSource[]
  importRuns     ImportRun[]
}

model Membership {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role        Role
  createdAt   DateTime  @default(now())

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

// Pending until the invitee signs in with Google as this email (stored lowercase).
model Invite {
  id          String    @id @default(cuid())
  email       String
  role        Role
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedById String
  invitedBy   User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  acceptedAt  DateTime?

  @@unique([workspaceId, email])
  @@index([email])
}

// ---------- Core entities ----------

model Course {
  id          String       @id @default(cuid())
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  isDemo      Boolean      @default(false)
  code        String
  name        String
  region      Region
  track       String
  description String
  status      CourseStatus
  createdAt   DateTime     @default(now())

  cohorts  Cohort[]
  modules  Module[]
  launches Launch[]
  issues   Issue[]
  projects Project[]

  @@unique([id, workspaceId])
  @@unique([workspaceId, code])
  @@index([workspaceId])
}

model Cohort {
  id               String       @id @default(cuid())
  workspaceId      String
  workspace        Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  isDemo           Boolean      @default(false)
  code             String
  name             String
  courseId         String
  course           Course       @relation(fields: [courseId, workspaceId], references: [id, workspaceId])
  startDate        DateTime
  endDate          DateTime
  capacity         Int
  enrolledLearners Int
  status           CohortStatus
  health           HealthStatus

  sessions Session[]
  feedback LearnerFeedback[]
  issues   Issue[]
  projects Project[]
  launches Launch[]

  @@unique([id, workspaceId])
  @@unique([workspaceId, code])
  @@index([courseId])
  @@index([workspaceId])
}

model Instructor {
  id          String      @id @default(cuid())
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  isDemo      Boolean     @default(false)
  name        String
  email       String
  expertise   String // comma-separated tags
  region      Region
  rating      Float? // mean of their completed sessions' avgRating; null if none
  hiringStage HiringStage
  joinedAt    DateTime

  sessions Session[]

  @@unique([id, workspaceId])
  @@unique([workspaceId, email])
  @@index([workspaceId])
}

model SME {
  id           String      @id @default(cuid())
  workspaceId  String
  workspace    Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  isDemo       Boolean     @default(false)
  name         String
  email        String
  domain       String
  company      String
  hoursPerWeek Int
  hiringStage  HiringStage

  reviewedModules Module[]
  guestSessions   Session[]

  @@unique([id, workspaceId])
  @@unique([workspaceId, email])
  @@index([workspaceId])
}

model Module {
  id          String      @id @default(cuid())
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  isDemo      Boolean     @default(false)
  courseId    String
  course      Course      @relation(fields: [courseId, workspaceId], references: [id, workspaceId])
  title       String
  description String
  tags        String // comma-separated, like Instructor.expertise
  order       Int
  stage       ModuleStage
  ownerName   String
  reviewerId  String?
  reviewer    SME?        @relation(fields: [reviewerId], references: [id])
  dueDate     DateTime
  updatedAt   DateTime

  versions ModuleVersion[]
  sessions Session[]

  @@unique([courseId, order])
  @@unique([id, workspaceId])
  @@index([courseId])
  @@index([workspaceId])
}

model ModuleVersion {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  isDemo      Boolean   @default(false)
  moduleId    String
  module      Module    @relation(fields: [moduleId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  version     String
  changelog   String
  authorName  String
  createdAt   DateTime

  @@unique([moduleId, version])
  @@unique([id, workspaceId])
  @@index([workspaceId])
}

model Session {
  id           String        @id @default(cuid())
  workspaceId  String
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  isDemo       Boolean       @default(false)
  cohortId     String
  cohort       Cohort        @relation(fields: [cohortId, workspaceId], references: [id, workspaceId])
  moduleId     String?
  module       Module?       @relation(fields: [moduleId], references: [id])
  instructorId String
  instructor   Instructor    @relation(fields: [instructorId, workspaceId], references: [id, workspaceId])
  smeId        String?
  sme          SME?          @relation(fields: [smeId], references: [id])
  title        String
  scheduledAt  DateTime
  durationMin  Int
  status       SessionStatus
  attendance   Int? // null until the session has happened
  avgRating    Float? // derived: mean of feedback ratings, rounded to 2dp
  recordingUrl String?

  feedback LearnerFeedback[]
  issues   Issue[]

  @@unique([id, workspaceId])
  @@index([cohortId])
  @@index([instructorId])
  @@index([scheduledAt])
  @@index([workspaceId])
}

model LearnerFeedback {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  isDemo      Boolean   @default(false)
  sessionId   String
  session     Session   @relation(fields: [sessionId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  cohortId    String
  cohort      Cohort    @relation(fields: [cohortId, workspaceId], references: [id, workspaceId])
  learnerId   String // pseudonymous learner handle
  rating      Int // 1–5
  sentiment   Sentiment
  theme       String // pacing | clarity | examples | audio | engagement | depth | ...
  comment     String
  createdAt   DateTime

  @@unique([sessionId, learnerId])
  @@unique([id, workspaceId])
  @@index([cohortId])
  @@index([workspaceId])
}

model Issue {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  isDemo      Boolean       @default(false)
  code        String
  title       String
  description String
  category    IssueCategory
  severity    Severity
  status      IssueStatus
  ownerName   String?
  courseId    String?
  course      Course?       @relation(fields: [courseId], references: [id])
  cohortId    String?
  cohort      Cohort?       @relation(fields: [cohortId], references: [id])
  sessionId   String?
  session     Session?      @relation(fields: [sessionId], references: [id])
  openedAt    DateTime
  resolvedAt  DateTime?

  @@unique([id, workspaceId])
  @@unique([workspaceId, code])
  @@index([status])
  @@index([workspaceId])
}

model Project {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  isDemo      Boolean       @default(false)
  title       String
  description String
  type        ProjectType
  status      ProjectStatus
  courseId    String
  course      Course        @relation(fields: [courseId, workspaceId], references: [id, workspaceId])
  cohortId    String
  cohort      Cohort        @relation(fields: [cohortId, workspaceId], references: [id, workspaceId])
  dueDate     DateTime
  submissions Int
  avgScore    Float? // 0–100, null until graded

  @@unique([id, workspaceId])
  @@index([workspaceId])
}

model Launch {
  id          String       @id @default(cuid())
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  isDemo      Boolean      @default(false)
  name        String
  courseId    String
  course      Course       @relation(fields: [courseId, workspaceId], references: [id, workspaceId])
  cohortId    String?
  cohort      Cohort?      @relation(fields: [cohortId], references: [id])
  targetDate  DateTime
  status      LaunchStatus
  ownerName   String

  checklist ChecklistItem[]

  @@unique([id, workspaceId])
  @@index([workspaceId])
}

model ChecklistItem {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  isDemo      Boolean   @default(false)
  launchId    String
  launch      Launch    @relation(fields: [launchId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  label       String
  ownerName   String
  dueDate     DateTime
  done        Boolean
  doneAt      DateTime?

  @@unique([id, workspaceId])
  @@index([workspaceId])
}

// Append-only log that powers "What changed".
model ActivityEvent {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  isDemo      Boolean   @default(false)
  entityType  String // Course | Cohort | Session | Issue | Module | Launch | Instructor | SME
  entityId    String
  action      String // created | updated | status_changed | resolved | rated | ...
  summary     String
  actorName   String
  createdAt   DateTime

  @@unique([id, workspaceId])
  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([workspaceId])
}

// ---------- Imports (CSV / Google Sheets) ----------

enum ImportKind {
  CSV
  SHEET
}

// A remembered import: where rows come from and how their columns map to fields.
// sourceKey identifies "the same source" for one-click re-imports:
//   SHEET: "sheet:<spreadsheetId>:<tabId>";  CSV: "csv:<header signature>".
model ImportSource {
  id              String     @id @default(cuid())
  workspaceId     String
  workspace       Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entityType      String // course | cohort | instructor | sme | module
  kind            ImportKind
  sourceKey       String
  name            String // file name or "Spreadsheet · Tab"
  spreadsheetId   String?
  sheetId         Int?
  sheetTitle      String?
  headerSignature String
  mapping         Json // { "<column header>": "<field name>" | null }
  createdById     String?
  createdBy       User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  lastSyncedAt    DateTime?

  runs ImportRun[]

  @@unique([workspaceId, entityType, sourceKey])
  @@unique([id, workspaceId])
  @@index([workspaceId])
}

// One import or sync, with what it did. Row errors are capped (see lib/data/imports.ts).
model ImportRun {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceId    String?
  source      ImportSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  entityType  String
  trigger     String // import | sync
  sourceName  String
  actorName   String
  created     Int
  updated     Int
  unchanged   Int
  skipped     Int
  errors      Json // [{ row: number, reasons: string[] }]
  createdAt   DateTime      @default(now())

  @@unique([id, workspaceId])
  @@index([workspaceId, createdAt])
}
